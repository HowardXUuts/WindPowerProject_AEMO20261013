# Copy to .env (gitignored) and fill in what you need. Nothing here is required
# to clone, test, run the pipeline or build the dashboard — every one of those
# paths works with no credential at all, and CI runs with this file absent.
#
# The assistant is the only component that can call out, and it needs a key
# only to answer a question it has no recorded reply for.

# An OpenAI-compatible endpoint. DeepSeek is the default provider.
DEEPSEEK_API_KEY=

# To use a different provider instead, name it and supply its key:
#   ASSISTANT_PROVIDER=openai
#   OPENAI_API_KEY=
#   ASSISTANT_PROVIDER=together
#   TOGETHER_API_KEY=
