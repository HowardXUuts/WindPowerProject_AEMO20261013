# Secrets
.env
.env.*
!.env.example

# Transient raw downloads — never committed (see PLAN.md)
data/raw/
*.zip
*.CSV

# DuckDB working files
*.duckdb
*.duckdb.wal
*.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local virtualenv
.venv/

# Fixtures are data, not transient downloads
!tests/fixtures/**

# Build artifacts
build/

# Dashboard JSON is derived from gold and silver, and regenerated by pages.yml.
# Committing it would duplicate every gold change in git history. The whole
# directory rather than *.json: the per-farm detail lives in docs/data/farm/,
# which a top-level glob does not reach.
docs/data/

# ML features are derived from silver and rebuilt by the ML workflow.
# A 50-column feature table is ~200 MB a year; the predictions it produces
# are ~17 MB and those are committed.
data/ml/features/
